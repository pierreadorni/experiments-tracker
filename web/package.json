{
  "name": "experimenttracker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --test test/*.mjs",
    "format": "prettier --write src scripts test ../gateway/src/index.ts ../gateway/db ../gateway/scripts ../gateway/test",
    "format:check": "prettier --check src scripts test ../gateway/src/index.ts ../gateway/db ../gateway/scripts ../gateway/test"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
